# Penny Stock Early-Warning System: example configuration.
# Copy to config.env, fill in the values, then: chmod 600 config.env
# Secrets are left empty here and are never committed. Values shown are the defaults.

# --- Feed ---
DATA_PROVIDER=moomoo
MOOMOO_API_KEY=
MOOMOO_PRIVATE_KEY_PATH=
MOOMOO_ALGO=ED25519
MOVERS_METHOD=plate-stock
MOVERS_PLATE=US
MOVERS_POLL_SECONDS=20
UNIVERSE_POLL_SECONDS=30
EXTRA_SYMBOLS=

# --- Finviz ---
FINVIZ_TOKEN=
FINVIZ_BASE=https://elite.finviz.com
FINVIZ_VIEW=111
FINVIZ_FILTERS=sh_price_u10,ind_stocksonly
FINVIZ_COLUMNS=

# --- Other sources ---
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_FEED=iex
FINNHUB_KEY=
SEC_USER_AGENT=

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Shariah ---
HALALSH_API_KEY=
HALALSH_BASE_URL=https://halal.sh
MUSAFFA_API_KEY=
MUSAFFA_BASE_URL=
SHARIAH_MODE=tag
SHARIAH_TTL_DAYS=7
SHARIAH_MAX_CALLS_MONTH=0

# --- Backup ---
BACKUP_LOCAL_DIR=
BACKUP_REMOTE=
BACKUP_PASSPHRASE=
BACKUP_HOURLY=1
BACKUP_TELEGRAM=0
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_MAX_AGE_HOURS=26

# --- AI ---
AI_BASE_URL=
AI_KEY=
AI_MODELS=deepseek-v4.1-flash,kimi-k3,glm-5.3
AI_FALLBACK_MODELS=deepseek-v4-pro,minimax-m3
AI_CANDIDATES=
AI_TIMEOUT=45
AI_CACHE_MINUTES=10
SHADOW_SAMPLE_RATE=0.2
TRACKER_AI=1
MODEL_SELECTION=auto
MIN_EVALUATED=100
SELECTION_WINDOW_DAYS=0
AI_MODEL_CATALOG=models_catalog.json
AI_DISCOVERY=auto
AI_MAX_MULTIPLIER=4
AI_PREMIUM_MODELS=
PREMIUM_SAMPLE_RATE=0.1
MODEL_HALVING_STAGES=30,60,100
MARKET_SYMBOLS=SPY,QQQ,IWM
TOKEN_NOTIFY_DAILY=0
TOKEN_LIMIT_DAILY=0

# --- Behaviour ---
MAX_PRICE=10
MIN_PRICE=0.10
ALERT_MIN_TIER=2
REALERT_SECONDS=3600
ALERT_EXTENDED=0
EXTENDED_PCT=100
WARMUP_CYCLES=2
WORKERS=8
RISK_USD=50
BASELINE_FALLBACK=300
FINVIZ_MAX_PER_MIN=20
RETENTION_DAYS=365

# --- Install ---
PENNY_URL=https://github.com/Ace1337z/penny-early-warning
PENNY_VERSION=main
INSTALL_DIR=/opt/penny
PENNY_HOME=
LOG_LEVEL=INFO

# --- Other defaults ---
AI_MAX_TOKENS=900
BASELINE_MIN_PER_MIN=20
MOOMOO_BASE_URL=https://webapi.moomoo.com
MOVERS_TOP_N=200
SAMPLE_SECONDS=55
SCORE_ACCEL_CAP=2
SCORE_DOLLAR_CAP=100000
SCORE_FROMHIGH_CAP=15
SCORE_RISE_CAP=50
SCORE_VOLX_CAP=2
SCORE_W_ACCEL=10
SCORE_W_DOLLAR=10
SCORE_W_FROMHIGH=10
SCORE_W_RISE=30
SCORE_W_VOLX=30
SCORE_W_VWAP=10
STATE_HOURS=6
TIER1_DOLLAR15=3000
TIER1_RISE15=3
TIER1_VOLX15=3
TIER2_DOLLAR15=10000
TIER2_RISE15=5
TIER2_RISE60=8
TIER2_VOLX15=10
TIER3_ACCEL=1.0
TIER3_DOLLAR15=25000
TIER3_FROM_HIGH=-8
TIER3_RISE60=15
TIER3_VOLX15=20
UNIVERSE_BATCH=400

